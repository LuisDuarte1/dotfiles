diff -urN orig/extensions/pi-autoresearch/pi-do-remote-bridge.ts new/extensions/pi-autoresearch/pi-do-remote-bridge.ts
--- orig/extensions/pi-autoresearch/pi-do-remote-bridge.ts	1970-01-01 01:00:00.000000000 +0100
+++ new/extensions/pi-autoresearch/pi-do-remote-bridge.ts	2026-09-22 22:51:20.920053816 +0100
@@ -0,0 +1,204 @@
+// pi-do-remote bridge: routes spawn/exec to a sandbox container when
+// the pi-do-remote extension is in remote mode. Added by a nix patch
+// when this extension is built from the upstream npm tarball.
+//
+// Mechanism: pi-do-remote installs `globalThis.__piDoRemote` on
+// /do-remote and removes it on /do-local. Every spawn/exec call site
+// in this package routes through `bridgedSpawn` / `bridgedExec` here,
+// which check the global and either delegate (remote) or fall through
+// to the original Node-local implementation.
+
+import { spawn as nodeSpawn, type ChildProcess } from "node:child_process";
+import { promises as fsp } from "node:fs";
+
+interface PiDoRemoteRuntime {
+  mode: "local" | "remote";
+  spawnBash?: (opts: {
+    command: string;
+    cwd: string;
+    env?: Record<string, string>;
+    timeoutMs?: number;
+    signal?: AbortSignal;
+  }) => ChildProcess;
+  execCommand?: (opts: {
+    cmd: string;
+    args: string[];
+    cwd: string;
+    env?: Record<string, string>;
+    timeoutMs?: number;
+    signal?: AbortSignal;
+  }) => Promise<{
+    stdout: string;
+    stderr: string;
+    code: number | null;
+    killed?: boolean;
+  }>;
+  // Optional: mirror a write to the sandbox so the in-container view
+  // of state files (autoresearch.jsonl etc.) stays in sync with the
+  // local source of truth. Fire-and-forget on the caller side.
+  fsWriteSandbox?: (opts: {
+    path: string;                     // local absolute path
+    content: string;
+    mode: "write" | "append";
+  }) => Promise<void>;
+  isKillTreeRemote?: () => boolean;
+}
+
+function runtime(): PiDoRemoteRuntime | undefined {
+  if (process.env.PI_AUTORESEARCH_NO_REMOTE === "1") return undefined;
+  return (globalThis as { __piDoRemote?: PiDoRemoteRuntime }).__piDoRemote;
+}
+
+// Returns true if a kill-tree on the local /proc is meaningless. The
+// pi-do-remote bridge runs experiments in the sandbox so the pid the
+// caller has is a container-side pid; the local proc walk would do
+// nothing harmful but also nothing useful. Caller short-circuits.
+
+export function isRemoteActive(): boolean {
+  const r = runtime();
+  return r?.mode === "remote";
+}
+
+// Spawn a bash command. In remote mode delegates to the registered
+// sandbox runner and returns a ChildProcess-compatible object. In
+// local mode falls back to node:child_process.spawn with the standard
+// options autoresearch uses.
+
+export function bridgedSpawn(opts: {
+  command: string;
+  cwd: string;
+  env?: Record<string, string>;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+  detached?: boolean;
+}): ChildProcess {
+  const r = runtime();
+  if (r?.mode === "remote" && typeof r.spawnBash === "function") {
+    return r.spawnBash({
+      command: opts.command,
+      cwd: opts.cwd,
+      env: opts.env,
+      timeoutMs: opts.timeoutMs,
+      signal: opts.signal,
+    });
+  }
+  return nodeSpawn("bash", ["-c", opts.command], {
+    cwd: opts.cwd,
+    env: opts.env as NodeJS.ProcessEnv | undefined,
+    signal: opts.signal,
+    detached: opts.detached ?? true,
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+}
+
+// Spawn a bash script (file path argv form: bash <script>). Used by
+// the hooks runner. Same dispatch as bridgedSpawn but with the script
+// path interpolated into a wrapper command for the remote side.
+
+export function bridgedSpawnScript(opts: {
+  scriptPath: string;
+  cwd: string;
+  env?: Record<string, string>;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+}): ChildProcess {
+  const r = runtime();
+  if (r?.mode === "remote" && typeof r.spawnBash === "function") {
+    return r.spawnBash({
+      command: `bash ${shellQuote(opts.scriptPath)}`,
+      cwd: opts.cwd,
+      env: opts.env,
+      timeoutMs: opts.timeoutMs,
+      signal: opts.signal,
+    });
+  }
+  return nodeSpawn("bash", [opts.scriptPath], {
+    cwd: opts.cwd,
+    env: opts.env as NodeJS.ProcessEnv | undefined,
+    signal: opts.signal,
+    timeout: opts.timeoutMs,
+  });
+}
+
+// Run command capturing all output. Used to replace pi.exec(...)
+// calls. The original pi.exec is passed in as `piExec` so we can
+// fall through identically when local.
+
+export async function bridgedExec(opts: {
+  cmd: string;
+  args: string[];
+  cwd: string;
+  env?: Record<string, string>;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+  piExec: (
+    cmd: string,
+    args: string[],
+    options: {
+      cwd?: string;
+      env?: Record<string, string>;
+      timeout?: number;
+      signal?: AbortSignal;
+    },
+  ) => Promise<{
+    stdout: string;
+    stderr: string;
+    code: number | null;
+    killed?: boolean;
+  }>;
+}): Promise<{ stdout: string; stderr: string; code: number | null; killed?: boolean }> {
+  const r = runtime();
+  if (r?.mode === "remote" && typeof r.execCommand === "function") {
+    return r.execCommand({
+      cmd: opts.cmd,
+      args: opts.args,
+      cwd: opts.cwd,
+      env: opts.env,
+      timeoutMs: opts.timeoutMs,
+      signal: opts.signal,
+    });
+  }
+  return opts.piExec(opts.cmd, opts.args, {
+    cwd: opts.cwd,
+    env: opts.env,
+    timeout: opts.timeoutMs,
+    signal: opts.signal,
+  });
+}
+
+// Minimal shell quoting for embedding paths into a remote bash -c
+// command. Single-quote everything, escape internal single quotes.
+
+function shellQuote(s: string): string {
+  return `'${s.replace(/'/g, `'\\''`)}'`;
+}
+
+// Write a text file. Always writes locally (so the dashboard and any
+// sync readers see the change immediately) and, when running under
+// pi-do-remote in remote mode, also pushes the new content to the
+// sandbox so in-container readers (LLM tool calls, autoresearch.sh,
+// etc.) see consistent state without waiting for /do-watch.
+//
+// Sandbox push is fire-and-forget by design: the local write is the
+// source of truth, so an extra round-trip to the sandbox shouldn't
+// gate the autoresearch loop. Errors are logged but never thrown back
+// to the caller.
+
+export async function bridgedWriteText(opts: {
+  path: string;
+  content: string;
+  mode: "write" | "append";
+}): Promise<void> {
+  if (opts.mode === "append") {
+    await fsp.appendFile(opts.path, opts.content);
+  } else {
+    await fsp.writeFile(opts.path, opts.content);
+  }
+  const r = runtime();
+  if (r?.mode === "remote" && typeof r.fsWriteSandbox === "function") {
+    void r.fsWriteSandbox(opts).catch((e: unknown) => {
+      const msg = e instanceof Error ? e.message : String(e);
+      console.error(`[pi-do-remote-bridge] sandbox mirror failed for ${opts.path}: ${msg}`);
+    });
+  }
+}
