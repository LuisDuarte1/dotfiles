+async function sendTldrawAsset(res: ServerResponse, relative: string) {
+	const file = resolve(TLDRAW_ASSETS_DIR, decodeURIComponent(relative))
+	if (!file.startsWith(TLDRAW_ASSETS_DIR)) return send(res, 404, 'Not found', 'text/plain; charset=utf-8')
+	let body: Buffer
