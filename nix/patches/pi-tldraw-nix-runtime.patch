+// packaged app dir is read-only in the nix store, so run it from a symlink mirror instead.
+function writableMirror(source: string) {
+	const state = process.env.XDG_STATE_HOME || join(homedir(), '.local', 'state')
+	const mirror = join(state, 'pi-tldraw', 'mcp-app')
+	mkdirSync(mirror, { recursive: true })
+	const wanted = new Set(readdirSync(source))
+	for (const name of readdirSync(mirror)) {
+		if (name !== '.wrangler' && !wanted.has(name)) rmSync(join(mirror, name), { recursive: true, force: true })
+	}
+	for (const name of wanted) {
+		const tmp = join(mirror, `.${name}.${process.pid}.tmp`)
+		rmSync(tmp, { force: true })
+		symlinkSync(join(source, name), tmp)
+		renameSync(tmp, join(mirror, name)) // atomic swap, so a concurrent pi never sees the link missing
+	}
+	return mirror
 }
 
