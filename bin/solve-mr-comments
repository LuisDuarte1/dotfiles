#!/bin/bash
# Resolve GitLab MR review comments using pi.
# Fetches unresolved discussion threads, opens an interactive pi session
# to help fix the issues, then generates and posts replies to each thread.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored messages (defined early for use in cleanup)
info() { echo -e "${BLUE}$*${NC}"; }
success() { echo -e "${GREEN}$*${NC}"; }
warn() { echo -e "${YELLOW}$*${NC}"; }
error() { echo -e "${RED}Error: $*${NC}" >&2; }

# Temporary directory and checkpoint file
TMPDIR="${TMPDIR:-/tmp}"
TEMP_PREFIX="$TMPDIR/solve-mr-comments-$$"
CHECKPOINT_FILE="$TMPDIR/solve-mr-comments-checkpoint.json"

# Track if we completed successfully
COMPLETED_SUCCESSFULLY=false

# Initialize global variables
USER_NOTES_JSON="{}"
SELECT_ALL=false
EXTRA_PROMPT=""
SESSION_ID=""

# Cleanup function - runs on EXIT, INT, TERM
cleanup() {
    if [[ "$COMPLETED_SUCCESSFULLY" == "true" ]]; then
        # Success - clean up everything: temp files, checkpoint, and the
        # persistent pi -p output buffer (no post-mortem needed on success).
        rm -f "$TEMP_PREFIX"* 2>/dev/null || true
        rm -f "$CHECKPOINT_FILE" 2>/dev/null || true
        rm -f "$TMPDIR/solve-mr-comments-replies.txt" 2>/dev/null || true
    else
        # Failure - clean temp files but keep checkpoint AND pi -p output for
        # post-mortem. Tell the user where to look.
        rm -f "$TEMP_PREFIX"* 2>/dev/null || true
        if [[ -f "$CHECKPOINT_FILE" ]]; then
            warn "Checkpoint saved to: $CHECKPOINT_FILE"
            warn "Run 'solve-mr-comments --resume' to continue"
        fi
        if [[ -f "$TMPDIR/solve-mr-comments-replies.txt" ]]; then
            warn "Last pi -p output: $TMPDIR/solve-mr-comments-replies.txt"
        fi
    fi
}
trap cleanup EXIT INT TERM

# Check if a command exists
check_dependency() {
    if ! command -v "$1" &> /dev/null; then
        error "'$1' is not installed. Please install it first."
        exit 1
    fi
}

# Optional pi-auth hook (installed by an overlay) that refreshes provider credentials:
# `check` exits 0 when valid, `login [--force]` refreshes, `env` prints exports for pi.
PI_AUTH_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/hooks/pi-auth"

force_pi_auth_refresh() {
    [[ -x "$PI_AUTH_HOOK" ]] || return 1
    info "Refreshing pi credentials via $PI_AUTH_HOOK ..."
    if ! "$PI_AUTH_HOOK" login --force </dev/tty >/dev/tty 2>&1; then
        error "pi-auth login failed."
        return 1
    fi
    eval "$("$PI_AUTH_HOOK" env)"
    success "Pi credentials refreshed."
}

ensure_pi_auth() {
    [[ -x "$PI_AUTH_HOOK" ]] || return 0
    if ! "$PI_AUTH_HOOK" check; then
        info "Pi credentials expired; running pi-auth login."
        "$PI_AUTH_HOOK" login </dev/tty >/dev/tty 2>&1 || { error "pi-auth login failed."; exit 1; }
    fi
    eval "$("$PI_AUTH_HOOK" env)"
}

# Wrap `pi -p ...` so a 401 (a credential revoked server-side before it expired)
# triggers a forced refresh through the pi-auth hook and one retry.
run_pi_p_with_auth_retry() {
    local out_file="$1"
    shift
    local args=("$@")

    ensure_pi_auth

    set +e
    pi -p "${args[@]}" 2>&1 | tee "$out_file"
    local exit_code=${PIPESTATUS[0]}
    set -e

    if [[ $exit_code -eq 0 ]]; then
        return 0
    fi

    # Detect a 401. Both HTML error pages and shorter JSON forms contain
    # the literal "401" string, so a simple grep is sufficient.
    if [[ -x "$PI_AUTH_HOOK" ]] && grep -q -E '\b401\b|Unauthorized' "$out_file" 2>/dev/null; then
        warn "pi -p returned 401 despite cached token; forcing auth refresh and retrying."
        force_pi_auth_refresh || return 1
        set +e
        pi -p "${args[@]}" 2>&1 | tee "$out_file"
        exit_code=${PIPESTATUS[0]}
        set -e
    fi

    return $exit_code
}

# Save checkpoint for resuming later
save_checkpoint() {
    local stage="$1"
    # Ensure all JSON variables have valid default values
    local notes_json="${USER_NOTES_JSON}"
    local replies="${REPLIES_JSON}"
    local threads="${SELECTED_THREADS}"
    
    # Set defaults if empty
    [[ -z "$notes_json" ]] && notes_json="{}"
    [[ -z "$replies" ]] && replies="{}"
    [[ -z "$threads" ]] && threads="[]"
    
    # Validate JSON or use defaults
    if ! echo "$notes_json" | jq empty 2>/dev/null; then
        notes_json="{}"
    fi
    if ! echo "$replies" | jq empty 2>/dev/null; then
        replies="{}"
    fi
    if ! echo "$threads" | jq empty 2>/dev/null; then
        threads="[]"
    fi
    
    jq -n \
        --arg stage "$stage" \
        --arg project_id "${PROJECT_ID:-}" \
        --arg mr_iid "${MR_IID:-}" \
        --arg mr_title "${MR_TITLE:-}" \
        --arg mr_web_url "${MR_WEB_URL:-}" \
        --arg session_id "${SESSION_ID:-}" \
        --argjson selected_threads "$threads" \
        --argjson replies_json "$replies" \
        --argjson user_notes "$notes_json" \
        '{
            stage: $stage,
            project_id: $project_id,
            mr_iid: $mr_iid,
            mr_title: $mr_title,
            mr_web_url: $mr_web_url,
            session_id: $session_id,
            selected_threads: $selected_threads,
            replies_json: $replies_json,
            user_notes: $user_notes
        }' > "$CHECKPOINT_FILE"
}

# Load checkpoint from file
load_checkpoint() {
    if [[ ! -f "$CHECKPOINT_FILE" ]]; then
        error "No checkpoint file found at $CHECKPOINT_FILE"
        exit 1
    fi
    
    info "Loading checkpoint from $CHECKPOINT_FILE..."
    
    CHECKPOINT_STAGE=$(jq -r '.stage' "$CHECKPOINT_FILE")
    PROJECT_ID=$(jq -r '.project_id' "$CHECKPOINT_FILE")
    MR_IID=$(jq -r '.mr_iid' "$CHECKPOINT_FILE")
    MR_TITLE=$(jq -r '.mr_title' "$CHECKPOINT_FILE")
    MR_WEB_URL=$(jq -r '.mr_web_url' "$CHECKPOINT_FILE")
    SESSION_ID=$(jq -r '.session_id // ""' "$CHECKPOINT_FILE")
    SELECTED_THREADS=$(jq '.selected_threads' "$CHECKPOINT_FILE")
    REPLIES_JSON=$(jq '.replies_json' "$CHECKPOINT_FILE")
    USER_NOTES_JSON=$(jq '.user_notes // {}' "$CHECKPOINT_FILE")
    SELECTED_COUNT=$(echo "$SELECTED_THREADS" | jq 'length')
    
    success "Checkpoint loaded. Stage: $CHECKPOINT_STAGE"
    echo "MR !$MR_IID: \"$MR_TITLE\""
    echo "Selected threads: $SELECTED_COUNT"
    echo ""
}

# ============================================================================
# STEP 1: VALIDATE ENVIRONMENT
# ============================================================================
validate_environment() {
    info "Checking dependencies..."
    
    check_dependency "fzf"
    check_dependency "glab"
    check_dependency "jq"
    check_dependency "pi"
    
    # Get the current branch name
    current_branch=$(git branch --show-current)
    
    if [[ -z "$current_branch" ]]; then
        error "Not on any branch (detached HEAD state?)"
        exit 1
    fi
    
    if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
        error "Currently on $current_branch branch. Switch to a feature branch."
        exit 1
    fi
    
    echo "Checking for open MR on branch: $current_branch"
    
    # Check for open MR
    if ! mr_output=$(glab mr view "$current_branch" --output json 2>&1); then
        if echo "$mr_output" | grep -qi "no open merge request"; then
            error "No open merge request found for branch: $current_branch"
            exit 1
        elif echo "$mr_output" | grep -qi "could not find"; then
            error "No merge request found for branch: $current_branch"
            exit 1
        else
            error "Error checking MR: $mr_output"
            exit 1
        fi
    fi
    
    # Extract MR info
    MR_IID=$(echo "$mr_output" | jq -r '.iid')
    MR_TITLE=$(echo "$mr_output" | jq -r '.title // "Untitled"')
    MR_WEB_URL=$(echo "$mr_output" | jq -r '.web_url // ""')
    PROJECT_ID=$(echo "$mr_output" | jq -r '.project_id')
    
    success "Found MR !$MR_IID: \"$MR_TITLE\""
    echo "URL: $MR_WEB_URL"
    echo ""

    # Allocate a deterministic pi session id up front so both pi invocations
    # (initial fix + reply generation) target the same session file.

    # Id regex: alphanumeric + . _ -, must start/end with alphanumeric.
    # The timestamp keeps re-runs on the same MR isolated.
    if [[ -z "$SESSION_ID" ]]; then
        SESSION_ID="solve-mr-${MR_IID}-$(date +%Y%m%d-%H%M%S)"
        info "Pi session id: $SESSION_ID"
    fi
}

# ============================================================================
# STEP 2 & 3: FETCH AND FILTER DISCUSSIONS
# ============================================================================
fetch_discussions() {
    info "Fetching unresolved discussions..."
    
    # Get current username
    CURRENT_USER=$(glab auth status 2>&1 | grep -oP 'Logged in to [^ ]+ as \K[^ ]+' | head -1)
    if [[ -z "$CURRENT_USER" ]]; then
        # Try alternative parsing
        CURRENT_USER=$(glab api user | jq -r '.username // ""')
    fi
    
    if [[ -z "$CURRENT_USER" ]]; then
        warn "Could not determine current username, will include all threads"
    else
        info "Current user: $CURRENT_USER"
    fi
    
    # Fetch all discussions via GitLab API
    discussions_json=$(glab api "projects/$PROJECT_ID/merge_requests/$MR_IID/discussions" --paginate)
    
    # Filter and format threads
    # Include:
    #   1. Resolvable threads that are unresolved and not by current user
    #   2. Plain (non-resolvable) comments from gsa_claude (AI reviewer)
    THREADS_JSON=$(echo "$discussions_json" | jq --arg user "$CURRENT_USER" '
        [.[] | select(
            (
                # Standard resolvable threads from other reviewers
                .notes[0].resolvable == true and
                .notes[0].resolved == false and
                (.notes[0].author.username != $user or $user == "")
            ) or (
                # Plain (non-resolvable) comments from reviewers
                # Only include if no one has replied yet (single note in discussion)
                .notes[0].resolvable == false and
                .notes[0].system == false and
                (.notes[0].author.username != $user or $user == "") and
                .notes[0].author.username != "gsa_murloc" and
                (.notes | length) == 1
            )
        ) | {
            discussion_id: .id,
            author_name: .notes[0].author.name,
            author_username: .notes[0].author.username,
            file_path: (.notes[0].position.new_path // .notes[0].position.old_path // null),
            old_line: .notes[0].position.old_line,
            new_line: .notes[0].position.new_line,
            line_range: .notes[0].position.line_range,
            is_plain_comment: (.notes[0].resolvable == false),
            conversation: [.notes[] | {
                author: .author.username,
                body: .body,
                created_at: .created_at
            }],
            first_comment: .notes[0].body
        }]
    ')
    
    THREAD_COUNT=$(echo "$THREADS_JSON" | jq 'length')
    
    if [[ "$THREAD_COUNT" -eq 0 ]]; then
        success "No unresolved threads from other reviewers. Nothing to do!"
        exit 0
    fi
    
    local resolvable_count plain_count
    resolvable_count=$(echo "$THREADS_JSON" | jq '[.[] | select(.is_plain_comment == false)] | length')
    plain_count=$(echo "$THREADS_JSON" | jq '[.[] | select(.is_plain_comment == true)] | length')
    
    success "Found $THREAD_COUNT thread(s): $resolvable_count resolvable, $plain_count plain comment(s)."
    echo ""
}

# ============================================================================
# STEP 4: INTERACTIVE SELECTION WITH FZF
# ============================================================================
select_threads() {
    # --select-all: bypass fzf, take all threads directly
    if [[ "$SELECT_ALL" == "true" ]]; then
        SELECTED_THREADS="$THREADS_JSON"
        SELECTED_COUNT=$(echo "$SELECTED_THREADS" | jq 'length')
        success "Auto-selected all $SELECTED_COUNT thread(s)."
        echo ""
        REPLIES_JSON="{}"
        save_checkpoint "selected"
        return
    fi

    info "Select threads to address (TAB to toggle, Ctrl+A to toggle all, ENTER to confirm):"
    echo ""
    
    # Create fzf input: index|discussion_id|display_text
    local fzf_input=""
    local i=0
    
    while IFS= read -r thread; do
        local discussion_id author file line comment location display is_plain
        discussion_id=$(echo "$thread" | jq -r '.discussion_id')
        author=$(echo "$thread" | jq -r '.author_username')
        file=$(echo "$thread" | jq -r '.file_path // "general"')
        line=$(echo "$thread" | jq -r 'if .new_line then .new_line else .old_line end // ""')
        comment=$(echo "$thread" | jq -r '.first_comment' | head -1 | cut -c1-60)
        is_plain=$(echo "$thread" | jq -r '.is_plain_comment')
        
        location="$file"
        if [[ -n "$line" && "$line" != "null" ]]; then
            location="$file:$line"
        fi
        
        # Escape special characters for display
        comment=$(echo "$comment" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')
        
        local tag=""
        if [[ "$is_plain" == "true" ]]; then
            tag="[comment] "
        fi
        
        display="${tag}[@$author] $location - $comment..."
        fzf_input+="$i|$discussion_id|$display"$'\n'
        i=$((i + 1))
    done < <(echo "$THREADS_JSON" | jq -c '.[]')
    
    # Save threads JSON to temp file for preview
    local threads_file="$TEMP_PREFIX-threads-for-fzf.json"
    echo "$THREADS_JSON" > "$threads_file"
    
    # Initialize notes file (per-discussion notes)
    local notes_file="$TEMP_PREFIX-notes.json"
    echo '{}' > "$notes_file"
    
    # Create a preview script that also shows user notes
    local preview_script="$TEMP_PREFIX-preview.sh"
    cat > "$preview_script" << 'PREVIEW_EOF'
#!/bin/bash
idx="$1"
threads_file="$2"
notes_file="$3"

# Get thread type
is_plain=$(jq -r --argjson i "$idx" '.[$i].is_plain_comment' "$threads_file")

# Get thread info
thread_info=$(jq -r --argjson i "$idx" '.[$i] | "Author: " + .author_name + " (@" + .author_username + ")\nFile: " + (.file_path // "general") + ":" + ((.new_line // .old_line // "?") | tostring) + "\n\nComment:\n" + .first_comment + "\n\nFull conversation:\n" + ([.conversation[] | "[@" + .author + "]: " + .body] | join("\n\n"))' "$threads_file")

if [[ "$is_plain" == "true" ]]; then
    echo "[PLAIN COMMENT - not a resolvable thread]"
    echo ""
fi

# Get discussion_id for this thread
discussion_id=$(jq -r --argjson i "$idx" '.[$i].discussion_id' "$threads_file")

# Get user notes if any
user_notes=$(jq -r --arg id "$discussion_id" '.[$id] // ""' "$notes_file")

echo "$thread_info"

if [[ -n "$user_notes" ]]; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📝 YOUR NOTES:"
    echo "$user_notes"
fi
PREVIEW_EOF
    chmod +x "$preview_script"
    
    # Create an edit-context script
    local edit_script="$TEMP_PREFIX-edit-context.sh"
    cat > "$edit_script" << 'EDIT_EOF'
#!/bin/bash
idx="$1"
threads_file="$2"
notes_file="$3"

# Get thread details
discussion_id=$(jq -r --argjson i "$idx" '.[$i].discussion_id' "$threads_file")
author_name=$(jq -r --argjson i "$idx" '.[$i].author_name' "$threads_file")
author_username=$(jq -r --argjson i "$idx" '.[$i].author_username' "$threads_file")
file_path=$(jq -r --argjson i "$idx" '.[$i].file_path // "general"' "$threads_file")
line_num=$(jq -r --argjson i "$idx" '.[$i] | (.new_line // .old_line // "?") | tostring' "$threads_file")
first_comment=$(jq -r --argjson i "$idx" '.[$i].first_comment' "$threads_file")
conversation=$(jq -r --argjson i "$idx" '.[$i].conversation | [.[] | "[@" + .author + "]: " + .body] | join("\n\n")' "$threads_file")

# Get existing notes
existing_notes=$(jq -r --arg id "$discussion_id" '.[$id] // ""' "$notes_file")

# Create temp file for editing
edit_file=$(mktemp)

cat > "$edit_file" << CONTENT
# Thread Context (read-only section above the line)
# Author: $author_name (@$author_username)
# File: $file_path:$line_num
#
# Comment:
$(echo "$first_comment" | sed 's/^/# /')
#
# Full conversation:
$(echo "$conversation" | sed 's/^/# /')
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# YOUR NOTES (edit below - these will be sent to pi as context)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

$existing_notes
CONTENT

# Open editor
${EDITOR:-vim} "$edit_file" </dev/tty >/dev/tty

# Extract notes (everything after the last separator line)
new_notes=$(sed -n '/^# ━.*━$/,$ { /^# ━.*━$/d; p; }' "$edit_file" | tail -n +2)

# Update notes file
if [[ -n "$new_notes" ]]; then
    jq --arg id "$discussion_id" --arg notes "$new_notes" '.[$id] = $notes' "$notes_file" > "$notes_file.tmp" && mv "$notes_file.tmp" "$notes_file"
else
    # Remove notes if empty
    jq --arg id "$discussion_id" 'del(.[$id])' "$notes_file" > "$notes_file.tmp" && mv "$notes_file.tmp" "$notes_file"
fi

rm -f "$edit_file"
EDIT_EOF
    chmod +x "$edit_script"
    
    # Run fzf with multi-select, all pre-selected
    # Preview shows full comment for selected thread
    SELECTED_INDICES=$(echo -n "$fzf_input" | \
        fzf --multi \
            --ansi \
            --bind 'ctrl-a:toggle-all' \
            --bind "ctrl-e:execute($edit_script {1} $threads_file $notes_file)" \
            --header $'TAB: toggle | Ctrl+A: toggle all | Ctrl+E: add notes | ENTER: confirm | ESC: cancel\n' \
            --delimiter='\|' \
            --with-nth=3.. \
            --bind "start:select-all" \
            --preview "$preview_script {1} $threads_file $notes_file" \
            --preview-window=right:50%:wrap \
        | cut -d'|' -f1) || {
            warn "Selection cancelled."
            exit 0
        }
    
    if [[ -z "$SELECTED_INDICES" ]]; then
        warn "No threads selected. Exiting."
        exit 0
    fi
    
    # Build selected threads JSON
    local indices_array
    indices_array=$(echo "$SELECTED_INDICES" | tr '\n' ',' | sed 's/,$//')
    SELECTED_THREADS=$(echo "$THREADS_JSON" | jq --argjson indices "[$indices_array]" '
        [to_entries[] | select(.key as $k | $indices | index($k)) | .value]
    ')
    
    # Load notes into global variable
    USER_NOTES_JSON=$(cat "$notes_file")
    
    SELECTED_COUNT=$(echo "$SELECTED_THREADS" | jq 'length')
    success "Selected $SELECTED_COUNT thread(s) to address."
    echo ""
    
    # Initialize REPLIES_JSON for checkpoint
    REPLIES_JSON="{}"
    
    # Save checkpoint after selection
    save_checkpoint "selected"
}

# ============================================================================
# STEP 5: BUILD PROMPT AND START PI
# ============================================================================
build_prompt_and_start_pi() {
    info "Building prompt for pi..."
    
    # Generate the prompt content
    PROMPT_CONTENT="# MR Review Comments to Address

You are helping resolve review comments on a GitLab merge request.
Below are the unresolved threads that need attention.
"
    
    local thread_num=1
    while IFS= read -r thread; do
        local discussion_id author_name author_username file new_line old_line line_info conversation is_plain
        discussion_id=$(echo "$thread" | jq -r '.discussion_id')
        author_name=$(echo "$thread" | jq -r '.author_name')
        author_username=$(echo "$thread" | jq -r '.author_username')
        file=$(echo "$thread" | jq -r '.file_path // "N/A"')
        new_line=$(echo "$thread" | jq -r '.new_line // ""')
        old_line=$(echo "$thread" | jq -r '.old_line // ""')
        is_plain=$(echo "$thread" | jq -r '.is_plain_comment')
        
        # Determine line info
        line_info=""
        if [[ -n "$new_line" && "$new_line" != "null" ]]; then
            line_info=":$new_line"
        elif [[ -n "$old_line" && "$old_line" != "null" ]]; then
            line_info=":$old_line"
        fi
        
        local thread_label="Thread"
        if [[ "$is_plain" == "true" ]]; then
            thread_label="Comment (plain, non-resolvable)"
        fi
        
        PROMPT_CONTENT+="
---

## $thread_label $thread_num
**Discussion ID:** \`$discussion_id\`
**Author:** $author_name (@$author_username)"
        
        if [[ "$file" != "N/A" && "$file" != "null" ]]; then
            PROMPT_CONTENT+="
**File:** \`$file$line_info\`"
        fi
        
        PROMPT_CONTENT+="
**Conversation:**
"
        # Output all comments in the thread
        conversation=$(echo "$thread" | jq -r '.conversation[] | "> **@\(.author):** \(.body)\n"')
        PROMPT_CONTENT+="$conversation
"
        # Add user notes if present for this discussion
        local user_note
        user_note=$(echo "$USER_NOTES_JSON" | jq -r --arg id "$discussion_id" '.[$id] // ""')
        if [[ -n "$user_note" ]]; then
            PROMPT_CONTENT+="**My Notes (context for fixing):**
> $user_note

"
        fi
        thread_num=$((thread_num + 1))
    done < <(echo "$SELECTED_THREADS" | jq -c '.[]')
    
    PROMPT_CONTENT+="
---

Please review these comments and make the necessary code changes.
When you're done, exit (/quit) and I'll help generate replies for each thread."

    # Append extra user instructions if provided via --prompt
    if [[ -n "$EXTRA_PROMPT" ]]; then
        PROMPT_CONTENT+="

---

## Additional Instructions
$EXTRA_PROMPT"
    fi
    
    # Save selected threads for later use
    THREADS_FILE="$TEMP_PREFIX-threads.json"
    echo "$SELECTED_THREADS" > "$THREADS_FILE"

    if [[ -z "$SESSION_ID" ]]; then
        error "No pi session id allocated. validate_environment must run first."
        exit 1
    fi

    info "Starting pi with $SELECTED_COUNT thread(s)..."
    info "Pi session id: $SESSION_ID"
    info "Exit pi (/quit) when you're done making changes."
    echo ""

    ensure_pi_auth

    # --session-id creates a new session with our id (or resumes if it exists,
    # which is what we want when re-running with --resume from checkpoint).
    pi --model claude-opus-4-7 --session-id "$SESSION_ID" "$PROMPT_CONTENT" || {
        error "pi exited with an error"
        exit 1
    }

    echo ""
    success "Pi session completed."

    # Save checkpoint after pi session
    save_checkpoint "pi_done"
}

# ============================================================================
# STEP 7: GENERATE REPLIES
# ============================================================================
generate_replies() {
    info "Generating replies for each thread..."
    
    # Build the reply generation prompt
    REPLY_PROMPT="Based on the changes you made to address the review comments, generate a reply for each thread explaining what was done.

Output ONLY valid JSON in this exact format (no markdown, no explanation, no code blocks):
{"
    
    # Add each discussion ID to the expected format
    local first=true
    while IFS= read -r thread; do
        local discussion_id
        discussion_id=$(echo "$thread" | jq -r '.discussion_id')
        if [[ "$first" == "true" ]]; then
            first=false
        else
            REPLY_PROMPT+=","
        fi
        REPLY_PROMPT+="
  \"$discussion_id\": \"<your reply here>\""
    done < <(echo "$SELECTED_THREADS" | jq -c '.[]')
    
    REPLY_PROMPT+="
}"
    
    # Persist outside TEMP_PREFIX so it survives cleanup() and is available
    # for post-mortem if pi fails (TEMP_PREFIX-prefixed files get deleted).
    REPLIES_FILE="$TMPDIR/solve-mr-comments-replies.txt"

    # Use --session (not --session-id) here: it errors out if the session is
    # missing, instead of silently creating an empty one with no LLM context.
    if [[ -z "$SESSION_ID" ]]; then
        error "No pi session available. Cannot generate replies without continuing the previous session."
        exit 1
    fi
    info "Continuing pi session $SESSION_ID to generate replies..."
    info "Pi output is also being saved to: $REPLIES_FILE"
    echo ""

    # run_pi_p_with_auth_retry handles ensure_pi_auth + tee + 401 retry.
    # Returns pi's exit code in $pi_exit (set +e is applied internally).
    set +e
    run_pi_p_with_auth_retry "$REPLIES_FILE" \
        --model claude-opus-4-7 --session "$SESSION_ID" "$REPLY_PROMPT"
    local pi_exit=$?
    set -e
    echo ""

    if [[ "$pi_exit" -ne 0 ]]; then
        error "pi -p exited with code $pi_exit"
        error "Full output is in: $REPLIES_FILE"
        error "Common causes: API/network error, model rate limit, or the session id no longer resolves."
        error "You can retry with: solve-mr-comments --resume"
        exit 1
    fi
    
    # Extract JSON. Strategy: (1) strip ``` fences if any, (2) try to jq-parse
    # the result whole, (3) fall back to the substring from first { to last }.
    local raw_output
    raw_output=$(cat "$REPLIES_FILE")

    # Strip markdown code fences (```json, ```javascript, ```).
    # Bare ``` lines are removed; content between them is kept.
    local stripped
    stripped=$(printf '%s\n' "$raw_output" | sed -E '/^```([a-zA-Z]+)?$/d')

    # Use jq -e 'type == "object"' so empty input AND non-object JSON
    # (numbers, strings, arrays) are both rejected as not-a-reply-map.
    if echo "$stripped" | jq -e 'type == "object"' >/dev/null 2>&1; then
        REPLIES_JSON="$stripped"
    else
        # Fallback: substring from first { to last }. Uses awk so JSON strings
        # with embedded `"` (escaped quotes) and newlines parse correctly.
        REPLIES_JSON=$(echo "$stripped" | awk '
            BEGIN { started = 0; buf = "" }
            {
                line = $0
                if (!started) {
                    idx = index(line, "{")
                    if (idx > 0) { started = 1; line = substr(line, idx) }
                }
                if (started) buf = buf line "\n"
            }
            END {
                last = 0
                for (i = 1; i <= length(buf); i++) {
                    if (substr(buf, i, 1) == "}") last = i
                }
                if (last > 0) print substr(buf, 1, last)
            }
        ')
        if [[ -z "$REPLIES_JSON" ]] || ! echo "$REPLIES_JSON" | jq -e 'type == "object"' >/dev/null 2>&1; then
            REPLIES_JSON="{}"
        fi
    fi
    
    # Validate JSON
    if ! echo "$REPLIES_JSON" | jq empty 2>/dev/null; then
        warn "Could not parse replies JSON from pi output."
        warn "Raw output saved to: $REPLIES_FILE"
        echo ""
        echo "You may need to write replies manually or review the output."
        REPLIES_JSON="{}"
    else
        success "Replies generated successfully."
    fi
    echo ""
    
    # Save checkpoint after generating replies
    save_checkpoint "replies_generated"
}

# ============================================================================
# STEP 8: POST REPLIES WITH CONFIRMATION
# ============================================================================
post_replies() {
    info "Posting replies to GitLab..."
    echo ""
    
    local posted=0
    local skipped=0
    local user_response
    
    # Use a for loop with array to avoid stdin conflicts with read -p
    local threads_array
    mapfile -t threads_array < <(echo "$SELECTED_THREADS" | jq -c '.[]')
    
    for thread in "${threads_array[@]}"; do
        local discussion_id author file first_comment is_plain
        discussion_id=$(echo "$thread" | jq -r '.discussion_id')
        author=$(echo "$thread" | jq -r '.author_username')
        file=$(echo "$thread" | jq -r '.file_path // "general"')
        first_comment=$(echo "$thread" | jq -r '.first_comment' | head -3)
        is_plain=$(echo "$thread" | jq -r '.is_plain_comment')
        
        # Get the generated reply for this thread
        local reply
        reply=$(echo "$REPLIES_JSON" | jq -r --arg id "$discussion_id" '.[$id] // ""')
        
        if [[ -z "$reply" || "$reply" == "null" ]]; then
            warn "No reply generated for thread $discussion_id, skipping..."
            skipped=$((skipped + 1))
            continue
        fi
        
        local type_label="Thread"
        if [[ "$is_plain" == "true" ]]; then
            type_label="Plain comment"
        fi
        
        echo "--- $type_label $discussion_id (@$author) ---"
        echo "File: $file"
        echo "Original comment:"
        echo "$first_comment" | sed 's/^/  /'
        echo ""
        echo "Proposed reply:"
        echo -e "${GREEN}$reply${NC}"
        echo ""
        
        read -p "Post this reply? [y/N/e(dit)] " -n 1 -r user_response </dev/tty
        echo ""
        
        if [[ $user_response =~ ^[Yy]$ ]]; then
            # POST the reply via GitLab API
            if glab api "projects/$PROJECT_ID/merge_requests/$MR_IID/discussions/$discussion_id/notes" \
                -X POST \
                -f body="$reply" > /dev/null 2>&1; then
                success "Posted!"
                posted=$((posted + 1))
            else
                error "Failed to post reply"
                skipped=$((skipped + 1))
            fi
        elif [[ $user_response =~ ^[Ee]$ ]]; then
            # Edit the reply in vim
            local edit_file="$TEMP_PREFIX-edit-reply.md"
            echo "$reply" > "$edit_file"
            
            if "${EDITOR:-vim}" "$edit_file" </dev/tty >/dev/tty; then
                # Vim exited successfully - use the edited reply
                reply=$(cat "$edit_file")
                rm -f "$edit_file"
                
                if [[ -z "$reply" ]]; then
                    warn "Empty reply, skipping..."
                    skipped=$((skipped + 1))
                else
                    echo ""
                    echo "Edited reply:"
                    echo -e "${GREEN}$reply${NC}"
                    echo ""
                    
                    # POST the edited reply
                    if glab api "projects/$PROJECT_ID/merge_requests/$MR_IID/discussions/$discussion_id/notes" \
                        -X POST \
                        -f body="$reply" > /dev/null 2>&1; then
                        success "Posted!"
                        posted=$((posted + 1))
                    else
                        error "Failed to post reply"
                        skipped=$((skipped + 1))
                    fi
                fi
            else
                # Vim exited with error - abort
                rm -f "$edit_file"
                error "Editor exited with error. Aborting."
                save_checkpoint "replies_generated"
                exit 1
            fi
        else
            # User said no - open vim to edit
            local edit_file="$TEMP_PREFIX-edit-reply.md"
            echo "$reply" > "$edit_file"
            
            info "Opening editor to modify reply..."
            if "${EDITOR:-vim}" "$edit_file" </dev/tty >/dev/tty; then
                # Vim exited successfully - use the edited reply
                reply=$(cat "$edit_file")
                rm -f "$edit_file"
                
                if [[ -z "$reply" ]]; then
                    warn "Empty reply, skipping..."
                    skipped=$((skipped + 1))
                else
                    echo ""
                    echo "Edited reply:"
                    echo -e "${GREEN}$reply${NC}"
                    echo ""
                    
                    # POST the edited reply
                    if glab api "projects/$PROJECT_ID/merge_requests/$MR_IID/discussions/$discussion_id/notes" \
                        -X POST \
                        -f body="$reply" > /dev/null 2>&1; then
                        success "Posted!"
                        posted=$((posted + 1))
                    else
                        error "Failed to post reply"
                        skipped=$((skipped + 1))
                    fi
                fi
            else
                # Vim exited with error - abort
                rm -f "$edit_file"
                error "Editor exited with error. Aborting."
                save_checkpoint "replies_generated"
                exit 1
            fi
        fi
        
        echo ""
    done
    
    echo ""
    success "Done! Posted $posted replies, skipped $skipped."
    
    # Mark as completed successfully
    COMPLETED_SUCCESSFULLY=true
}

# ============================================================================
# MAIN
# ============================================================================
show_help() {
    cat << 'EOF'
Usage: solve-mr-comments [OPTIONS]

Resolve GitLab MR review comments using pi.

Options:
    --select-all        Select all unresolved threads, bypassing fzf
    --prompt <text>     Add extra instructions to the pi prompt
    --resume            Resume from a previous checkpoint
    --help              Show this help message

Examples:
    solve-mr-comments --select-all
    solve-mr-comments --select-all --prompt "only amend commits at the end when done"
    solve-mr-comments --prompt "make sure to run tests before finishing"

If the script fails, a checkpoint is saved to /tmp/solve-mr-comments-checkpoint.json
Run with --resume to continue from where you left off.
EOF
}

main() {
    local resume_mode=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --resume)
                resume_mode=true
                shift
                ;;
            --select-all)
                SELECT_ALL=true
                shift
                ;;
            --prompt)
                if [[ -z "${2:-}" ]]; then
                    error "--prompt requires an argument"
                    exit 1
                fi
                EXTRA_PROMPT="$2"
                shift 2
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    echo ""
    echo "=========================================="
    echo "  solve-mr-comments"
    echo "=========================================="
    echo ""
    
    if [[ "$resume_mode" == "true" ]]; then
        # Resume from checkpoint
        load_checkpoint
        
        case "$CHECKPOINT_STAGE" in
            selected)
                info "Resuming from: thread selection (will start pi)"
                build_prompt_and_start_pi
                generate_replies
                post_replies
                ;;
            pi_done)
                info "Resuming from: pi completed (will generate replies)"
                generate_replies
                post_replies
                ;;
            replies_generated)
                info "Resuming from: replies generated (will post replies)"
                post_replies
                ;;
            *)
                error "Unknown checkpoint stage: $CHECKPOINT_STAGE"
                exit 1
                ;;
        esac
    else
        # Normal flow
        validate_environment
        fetch_discussions
        select_threads
        build_prompt_and_start_pi
        generate_replies
        post_replies
    fi
}

main "$@"
