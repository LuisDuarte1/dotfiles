+// applyLineResets() strips it before output, like CURSOR_MARKER.
+export const SOFT_WRAP_MARKER = "\x1b_pi:w;";
+const SOFT_WRAP_MARKER_REGEX = /\x1b_pi:w;[^\x07]*\x07/g;
