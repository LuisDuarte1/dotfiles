[Unit]
Description=Prometheus process exporter (per-process metrics for the local Prometheus)

[Service]
# Per-thread metrics churn with every JVM thread and no query uses them; empty groups would
# keep the series of long-gone worktrees alive.
ExecStart=%h/.nix-profile/bin/process-exporter -web.listen-address=127.0.0.1:9256 -config.path=%h/.config/prometheus/process-exporter.yml -threads=false -remove-empty-groups
Restart=on-failure
# systemd-oomd kills a child of app.slice under memory pressure; the metrics stack must
# outlive the very events it records.
ManagedOOMPreference=avoid

[Install]
WantedBy=default.target
