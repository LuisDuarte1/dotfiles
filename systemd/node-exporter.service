[Unit]
Description=Prometheus node exporter (machine metrics for the local Prometheus)

[Service]
ExecStart=%h/.nix-profile/bin/node_exporter --web.listen-address=127.0.0.1:9100
Restart=on-failure
# systemd-oomd kills a child of app.slice under memory pressure; the metrics stack must
# outlive the very events it records.
ManagedOOMPreference=avoid

[Install]
WantedBy=default.target
