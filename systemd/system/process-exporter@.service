[Unit]
Description=Prometheus process exporter for %i (per-process metrics for the local Prometheus)

[Service]
# User= also sets ${HOME} for ExecStart; env runs the binary because the executable itself
# cannot hold variables, which keeps the template free of any user's home path.
User=%i
# Per-thread metrics churn with every JVM thread and no query uses them; empty groups would
# keep the series of long-gone worktrees alive.
ExecStart=/usr/bin/env ${HOME}/.nix-profile/bin/process-exporter -web.listen-address=127.0.0.1:9256 -config.path=${HOME}/.config/prometheus/process-exporter.yml -threads=false -remove-empty-groups
Restart=on-failure
# Last in line for the kernel OOM killer and skipped by systemd-oomd, so it records the crunches
# it would otherwise die in; not -1000, so MemoryMax can still kill a runaway and restart it.
OOMScoreAdjust=-999
ManagedOOMPreference=omit
MemoryMax=256M

[Install]
WantedBy=multi-user.target
